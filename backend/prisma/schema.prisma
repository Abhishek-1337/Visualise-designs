// Visualise CRM - Minimalist Prisma Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

// Enums
enum Role {
  ADMIN
  MANAGER
  EMPLOYEE
  CLIENT
}

enum ContactStatus {
  LEAD
  PROSPECT
  ACTIVE
  INACTIVE
  VIP
}

enum DealStatus {
  DRAFT
  SENT
  CHANGES_REQUESTED
  ACCEPTED
  REJECTED
  CONVERTED_TO_PROJECT
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum PipelineStage {
  NEW_LEAD
  QUALIFIED
  PROPOSAL_SENT
  NEGOTIATION
  CLOSED_WON
  CLOSED_LOST
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

model Tenant {
  id              String        @id @default(uuid())
  companyName     String    
  users           User[]
  contacts        Contact[]
  deals           Deal[]
  projects        Project[]
  tasks           Task[]
  activities      Activity[]
  invitations     Invitation[]
  messages        Message[]
  files           File[]
  notifications   Notification[]
  invoices        Invoice[]
  payments        Payment[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

// Models
model User {
  id            String    @id @default(uuid())
  email         String    @unique
  name          String
  password      String?
  avatar        String?
  role          Role      @default(EMPLOYEE)
  phone         String?
  timezone      String    @default("UTC")
  language      String    @default("en")
  isActive      Boolean   @default(true)
  lastLogin     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id])

  // OAuth
  oauthProvider String?
  oauthId       String?   @unique

  // Relations
  contacts          Contact[]
  assignedTasks     Task[]          @relation("AssignedTasks")
  createdTasks      Task[]          @relation("CreatedTasks")
  projects          Project[]       @relation("ProjectMembers")
  deals             Deal[]          @relation("AssignedDeals")
  activities        Activity[]
  invitedInvitations Invitation[]   @relation("InvitedBy")
  sentMessages      Message[]       @relation("SentMessages")
  receivedMessages  Message[]       @relation("ReceivedMessages")
  uploadedFiles     File[]
  notifications     Notification[]

  @@index([email])
  @@index([role])
  @@index([tenantId])
}

model Contact {
  id              String         @id @default(uuid())
  firstName       String
  lastName        String
  email           String         @unique
  phone           String?
  company         String?
  jobTitle        String?
  status          ContactStatus  @default(LEAD)
  source          String?        
  country         String?
  notes           String?
  value           Float?         
  isArchived      Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  // Relations
  tenantId        String
  tenant          Tenant         @relation(fields: [tenantId], references: [id])
  ownerId         String
  owner           User           @relation(fields: [ownerId], references: [id])
  deals           Deal[]
  projects        Project[]
  tasks           Task[]
  activities      Activity[]
  files           File[]
  invoices        Invoice[]

  @@index([status])
  @@index([ownerId])
  @@index([tenantId])
}

model Deal {
  id              String       @id @default(uuid())
  title           String
  description     String?
  value           Float
  probability     Int          @default(0)   // 0-100
  status          DealStatus   @default(DRAFT)
  stage           PipelineStage @default(NEW_LEAD)
  expectedCloseDate DateTime?
  closedDate      DateTime?
  changeRequestNotes String?   @default("")
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  // Relations
  tenantId        String
  tenant          Tenant       @relation(fields: [tenantId], references: [id])
  contactId       String
  contact         Contact      @relation(fields: [contactId], references: [id])
  assignedToId    String?
  assignedTo      User?        @relation("AssignedDeals", fields: [assignedToId], references: [id])
  project         Project?
  activities      Activity[]

  @@index([status])
  @@index([stage])
  @@index([contactId])
  @@index([tenantId])
}

model Project {
  id              String         @id @default(uuid())
  name            String
  description     String?
  status          ProjectStatus  @default(PLANNING)
  startDate       DateTime?
  endDate         DateTime?
  budget          Float?
  progress        Int            @default(0)   // 0-100
  createdAt       DateTime     @default(now())
  updatedAt       DateTime       @updatedAt

  // Relations
  tenantId        String
  tenant          Tenant         @relation(fields: [tenantId], references: [id])
  contactId       String
  contact         Contact        @relation(fields: [contactId], references: [id])
  dealId          String?        @unique
  deal            Deal?          @relation(fields: [dealId], references: [id])
  members         User[]         @relation("ProjectMembers")
  tasks           Task[]
  activities      Activity[]
  messages        Message[]
  files           File[]

  @@index([status])
  @@index([contactId])
  @@index([tenantId])
}

model Task {
  id            String       @id @default(uuid())
  title         String
  description   String?
  priority      TaskPriority @default(MEDIUM)
  status        TaskStatus   @default(TODO)
  dueDate       DateTime?
  completedAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  // Relations
  tenantId      String
  tenant        Tenant       @relation(fields: [tenantId], references: [id])
  contactId     String?
  contact       Contact?     @relation(fields: [contactId], references: [id])
  projectId     String?
  project       Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  assignedToId  String
  assignedTo    User         @relation("AssignedTasks", fields: [assignedToId], references: [id])
  createdById   String
  createdBy     User         @relation("CreatedTasks", fields: [createdById], references: [id])

  @@index([status])
  @@index([assignedToId])
  @@index([tenantId])
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  CANCELLED
}

model Invitation {
  id              String            @id @default(uuid())
  email           String
  role            Role              @default(EMPLOYEE)
  token           String            @unique
  status          InvitationStatus  @default(PENDING)
  expiresAt       DateTime
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  // Relations
  tenantId        String
  tenant          Tenant            @relation(fields: [tenantId], references: [id])
  invitedById     String
  invitedBy       User              @relation("InvitedBy", fields: [invitedById], references: [id])

  @@index([email])
  @@index([token])
  @@index([tenantId])
}

model Message {
  id         String   @id @default(uuid())
  content    String
  senderId   String
  receiverId String
  tenantId   String
  projectId  String?
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  sender   User   @relation("SentMessages", fields: [senderId], references: [id])
  receiver User   @relation("ReceivedMessages", fields: [receiverId], references: [id])
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  project  Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@index([receiverId])
  @@index([tenantId])
  @@index([projectId])
  @@index([createdAt])
}

model Activity {
  id          String    @id @default(uuid())
  type        String    // contact_created, deal_moved, task_completed, message_sent, etc.
  description String
  metadata    Json?     // Additional context-specific data
  createdAt   DateTime  @default(now())

  // Relations
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  contactId   String?
  contact     Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  dealId      String?
  deal        Deal?     @relation(fields: [dealId], references: [id], onDelete: SetNull)
  projectId   String?
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([type])
  @@index([tenantId])
  @@index([createdAt(sort: Desc)])
}

model File {
  id            String   @id @default(uuid())
  originalName  String
  mimeType      String
  size          Int
  key           String   @unique
  url           String?
  description   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  uploadedById  String
  uploadedBy    User     @relation(fields: [uploadedById], references: [id])
  contactId     String?
  contact       Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  projectId     String?
  project       Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([contactId])
  @@index([projectId])
  @@index([uploadedById])
}

model Notification {
  id          String   @id @default(uuid())
  type        String
  title       String
  description String?
  isRead      Boolean  @default(false)
  metadata    Json?
  createdAt   DateTime @default(now())

  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  userId      String
  user        User     @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
  @@index([tenantId])
}

model Invoice {
  id             String        @id @default(uuid())
  invoiceNumber  String        @unique
  amount         Float
  status         InvoiceStatus @default(DRAFT)
  dueDate        DateTime?
  description    String?
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id])
  contactId      String
  contact        Contact       @relation(fields: [contactId], references: [id])
  payments       Payment[]

  @@index([tenantId])
  @@index([contactId])
  @@index([status])
}

model Payment {
  id              String        @id @default(uuid())
  amount          Float
  currency        String        @default("USD")
  status          PaymentStatus @default(PENDING)
  stripeSessionId String?
  paidAt          DateTime?
  createdAt       DateTime      @default(now())

  invoiceId       String
  invoice         Invoice       @relation(fields: [invoiceId], references: [id])
  tenantId        String
  tenant          Tenant        @relation(fields: [tenantId], references: [id])

  @@index([invoiceId])
  @@index([tenantId])
}
