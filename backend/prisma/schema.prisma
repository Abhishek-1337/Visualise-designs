// Visualise CRM - Prisma Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

// Enums
enum Role {
  ADMIN
  MANAGER
  EMPLOYEE
  CLIENT
}

enum ContactStatus {
  LEAD
  PROSPECT
  ACTIVE
  INACTIVE
  VIP
}

enum DealStatus {
  OPEN
  WON
  LOST
  DRAFT
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum CommunicationType {
  CALL
  EMAIL
  MEETING
  MESSAGE
  ZOOM
}

enum InvoiceStatus {
  DRAFT
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

enum PipelineStage {
  NEW_LEAD
  QUALIFIED
  PROPOSAL_SENT
  NEGOTIATION
  CLOSED_WON
  CLOSED_LOST
}

// Models
model User {
  id            String    @id @default(uuid())
  email         String    @unique
  name          String
  password      String?
  avatar        String?
  role          Role      @default(EMPLOYEE)
  phone         String?
  timezone      String    @default("UTC")
  language      String    @default("en")
  isActive      Boolean   @default(true)
  lastLogin     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // OAuth
  oauthProvider String?
  oauthId       String?   @unique

  // Relations
  ownedContacts     Contact[]
  assignedTasks      Task[]          @relation("AssignedTasks")
  createdTasks       Task[]          @relation("CreatedTasks")
  assignedProjects   Project[]       @relation("ProjectMembers")
  assignedDeals      Deal[]          @relation("AssignedDeals")
  communications     Communication[]
  activities         Activity[]
  createdInvoices    Invoice[]       @relation("CreatedInvoices")
  sessions           Session[]
  teamMemberships    TeamMember[]
  notifications      Notification[]

  @@index([email])
  @@index([role])
  @@index([isActive])
}

model Contact {
  id              String         @id @default(uuid())
  firstName       String
  lastName        String
  email           String         @unique
  phone           String?
  company         String?
  jobTitle        String?
  status          ContactStatus  @default(LEAD)
  source          String?        // LinkedIn, Referral, Website, etc.
  website         String?
  address         String?
  city            String?
  state           String?
  country         String?
  postalCode      String?
  notes           String?
  value           Float?         // Estimated deal value
  isArchived      Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  // Relations
  ownerId         String
  owner           User           @relation(fields: [ownerId], references: [id])
  deals           Deal[]
  projects        Project[]
  communications  Communication[]
  tasks           Task[]
  invoices        Invoice[]
  files           File[]

  @@index([status])
  @@index([ownerId])
  @@index([company])
  @@index([country])
}

model Deal {
  id              String       @id @default(uuid())
  title           String
  description     String?
  value           Float
  probability     Int          @default(0)   // 0-100
  status          DealStatus   @default(OPEN)
  stage           PipelineStage @default(NEW_LEAD)
  expectedCloseDate DateTime?
  closedDate      DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  // Relations
  contactId       String
  contact         Contact      @relation(fields: [contactId], references: [id])
  assignedToId    String?
  assignedTo      User?        @relation("AssignedDeals", fields: [assignedToId], references: [id])
  activities      Activity[]

  @@index([status])
  @@index([stage])
  @@index([contactId])
  @@index([expectedCloseDate])
}

model Project {
  id              String         @id @default(uuid())
  name            String
  description     String?
  status          ProjectStatus  @default(PLANNING)
  startDate       DateTime?
  endDate         DateTime?
  budget          Float?
  progress        Int            @default(0)   // 0-100
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  // Relations
  contactId       String
  contact         Contact        @relation(fields: [contactId], references: [id])
  members         User[]         @relation("ProjectMembers")
  milestones      Milestone[]
  tasks           Task[]
  files           File[]
  activities      Activity[]

  @@index([status])
  @@index([contactId])
}

model Milestone {
  id          String    @id @default(uuid())
  title       String
  description String?
  dueDate     DateTime?
  isCompleted Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([dueDate])
}

model Task {
  id            String       @id @default(uuid())
  title         String
  description   String?
  priority      TaskPriority @default(MEDIUM)
  status        TaskStatus   @default(TODO)
  dueDate       DateTime?
  completedAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  // Relations
  contactId     String?
  contact       Contact?     @relation(fields: [contactId], references: [id])
  projectId     String?
  project       Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  assignedToId  String
  assignedTo    User         @relation("AssignedTasks", fields: [assignedToId], references: [id])
  createdById   String
  createdBy     User         @relation("CreatedTasks", fields: [createdById], references: [id])

  @@index([status])
  @@index([priority])
  @@index([assignedToId])
  @@index([dueDate])
}

model Communication {
  id          String            @id @default(uuid())
  type        CommunicationType
  subject     String?
  content     String?
  direction   String            @default("outbound")  // inbound/outbound
  duration    Int?              // in minutes
  outcome     String?
  notes       String?
  scheduledAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  // Relations
  contactId   String
  contact     Contact           @relation(fields: [contactId], references: [id])
  userId      String
  user        User              @relation(fields: [userId], references: [id])

  @@index([contactId])
  @@index([type])
  @@index([createdAt])
}

model Invoice {
  id              String        @id @default(uuid())
  invoiceNumber   String        @unique
  description     String?
  amount          Float
  tax             Float         @default(0)
  total           Float
  status          InvoiceStatus @default(DRAFT)
  issueDate       DateTime      @default(now())
  dueDate         DateTime
  paidDate        DateTime?
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  contactId       String
  contact         Contact       @relation(fields: [contactId], references: [id])
  createdById     String
  createdBy       User          @relation("CreatedInvoices", fields: [createdById], references: [id])

  @@index([status])
  @@index([contactId])
  @@index([dueDate])
  @@index([invoiceNumber])
}

model File {
  id          String    @id @default(uuid())
  name        String
  originalName String
  mimeType    String
  size        Int       // in bytes
  path        String    // storage path
  category    String?   // contract, proposal, invoice, etc.
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  contactId   String?
  contact     Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  projectId   String?
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([contactId])
  @@index([projectId])
}

model Team {
  id          String    @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  members     TeamMember[]

  @@index([name])
}

model TeamMember {
  id        String   @id @default(uuid())
  role      String   @default("member")  // admin, lead, member
  joinedAt  DateTime @default(now())

  // Relations
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
}

model Session {
  id           String    @id @default(uuid())
  token        String    @unique
  expiresAt    DateTime
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime  @default(now())

  // Relations
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}

model Activity {
  id          String    @id @default(uuid())
  type        String    // deal_moved, task_completed, communication_logged, etc.
  description String
  metadata    Json?     // Additional context-specific data
  createdAt   DateTime  @default(now())

  // Relations
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  dealId      String?
  deal        Deal?     @relation(fields: [dealId], references: [id], onDelete: SetNull)
  projectId   String?
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([type])
  @@index([createdAt(sort: Desc)])
}

model AutomationRule {
  id          String    @id @default(uuid())
  name        String
  description String?
  trigger     String    // lead_created, deal_won, task_due, etc.
  conditions  Json      // Rule conditions
  actions     Json      // Actions to perform
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([trigger])
  @@index([isActive])
}

model Notification {
  id          String    @id @default(uuid())
  type        String
  title       String
  message     String
  isRead      Boolean   @default(false)
  link        String?   // URL to navigate to
  createdAt   DateTime  @default(now())

  // Relations
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt(sort: Desc)])
}

model Integration {
  id          String    @id @default(uuid())
  name        String    @unique  // google-calendar, gmail, zoom, slack, etc.
  isConnected Boolean   @default(false)
  config      Json?     // Integration-specific configuration
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([name])
  @@index([isConnected])
}
